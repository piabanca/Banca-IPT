@page "/profile"

<PageTitle>My Profile</PageTitle>

<link href="css/Profile.css" rel="stylesheet" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<div class="profile-page">

    <!-- Cover -->
    <div class="cover">
        <img src="images/cover-photo.jpg" />
    </div>

    <div class="profile-card">

        <img src="images/profile.jpg" class="profile-img" />

        @if (!isEditing)
        {
            <h1>@profile.FullName</h1>

            <span class="title">
                @profile.Title
            </span>

            <div class="heart-line">
                <hr />
                <i class="fa-solid fa-heart"></i>
                <hr />
            </div>

            <p class="bio">
                @profile.Bio
            </p>

            <div class="contact">

                <div class="contact-box">
                    <i class="fa-solid fa-location-dot"></i>
                    @profile.Location
                </div>

                <div class="contact-box">
                    <i class="fa-solid fa-envelope"></i>
                    @profile.Email
                </div>

            </div>

            <div class="stats">

                <div class="stat">
                    <i class="fa-solid fa-folder"></i>
                    <h2>@profile.Projects</h2>
                    <p>Projects</p>
                </div>

                <div class="stat">
                    <i class="fa-solid fa-users"></i>
                    <h2>@profile.Followers</h2>
                    <p>Followers</p>
                </div>

                <div class="stat">
                    <i class="fa-solid fa-user"></i>
                    <h2>@profile.Following</h2>
                    <p>Following</p>
                </div>

            </div>

            <button class="edit-btn" @onclick="EditProfile">
                <i class="fa-solid fa-pen"></i>
                Edit Profile
            </button>
        }
        else
        {
            <EditForm Model="profile" OnValidSubmit="SaveProfile">

                <div class="form-group">
                    <label>Full Name</label>
                    <InputText class="form-control" @bind-Value="profile.FullName" />
                </div>

                <div class="form-group">
                    <label>Title</label>
                    <InputText class="form-control" @bind-Value="profile.Title" />
                </div>

                <div class="form-group">
                    <label>Bio</label>
                    <InputTextArea class="form-control"
                                   @bind-Value="profile.Bio" />
                </div>

                <div class="form-group">
                    <label>Location</label>
                    <InputText class="form-control"
                               @bind-Value="profile.Location" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText class="form-control"
                               @bind-Value="profile.Email" />
                </div>

                <div class="button-group">

                    <button class="save-btn" type="submit">
                        Save
                    </button>

                    <button class="cancel-btn"
                            type="button"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>
        }

    </div>

    <!-- About Me -->

    <div class="bottom">

        <div class="card">

            <h2>
                <i class="fa-solid fa-user"></i>
                About Me
            </h2>

            <p>
                I enjoy learning new things,and spending my free time watching movies, listening to music, playing mobile games, and reading books.
            </p>

        </div>

        <div class="card">

            <h2>
                <i class="fa-solid fa-star"></i>
                My Hobbies
            </h2>

            <div class="hobbies">

                <div class="hobby">
                    <i class="fa-solid fa-film"></i>
                    Watching Movies
                </div>

                <div class="hobby">
                    <i class="fa-solid fa-music"></i>
                    Listening to Music
                </div>

                <div class="hobby">
                    <i class="fa-solid fa-gamepad"></i>
                    Mobile Games
                </div>

                <div class="hobby">
                    <i class="fa-solid fa-book"></i>
                    Read Books
                </div>

            </div>

        </div>

    </div>

</div>

@code {

    bool isEditing = false;

    ProfileModel profile = new()
    {
        FullName = "Pia V. Banca",
        Title = "IT Student",
        Bio = "To dream is to live and to pursue it is to keep on living.",
        Location = "Parang, Maguindanao",
        Email = "bancapia27@gmail.com",

        Projects = 0,
        Followers = 50,
        Following = 20,
    };

    void EditProfile()
    {
        isEditing = true;
    }

    void SaveProfile()
    {
        isEditing = false;
    }

    void CancelEdit()
    {
        isEditing = false;
    }

    public class ProfileModel
    {
        public string FullName { get; set; } = "";
        public string Title { get; set; } = "";
        public string Bio { get; set; } = "";
        public string Location { get; set; } = "";
        public string Email { get; set; } = "";

        public int Projects { get; set; }
        public int Followers { get; set; }
        public int Following { get; set; }
    }

}