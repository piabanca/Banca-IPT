@page "/"

@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/profile");
    }
}
<PageTitle>My Profile</PageTitle>

<div class="profile-container">

    <div class="cover"></div>

    <div class="profile-card">

        <img class="profile-img"
             src="images/profile.jpg"
             alt="Profile Picture" />

        <h1>Pia V. Banca</h1>

        <h3>IT Student</h3>

        <p class="bio">
            To dream is to live and to pursue it is to keep on living.
        </p>

        <div class="info">
            <span>📍 Parang, Maguindanao</span>
            <span>✉ bancapia27@gmail.com</span>
        </div>

        <div class="stats">

            <div>
                <h2>0</h2>
                <p>Projects</p>
            </div>

            <div>
                <h2>50</h2>
                <p>Followers</p>
            </div>

            <div>
                <h2>20</h2>
                <p>Following</p>
            </div>

        </div>

        <button class="btn-save">
            Edit Profile
        </button>

    </div>

</div>