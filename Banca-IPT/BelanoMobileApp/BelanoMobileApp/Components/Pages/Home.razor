        <div class="section-card">
            <h3 class="section-title">✨ My Hobbies & Interests</h3>
            <div class="hobby-list">
                <div class="hobby-tag">🎧 Listening to Music</div>
                <div class="hobby-tag">📚 Reading Books</div>
                <div class="hobby-tag">🎮 Playing Online Games</div>
                <div class="hobby-tag">✍️ Writing Notes</div>
                <div class="hobby-tag">🌿 Travel</div>
                <div class="hobby-tag">🎬 Watching Movies</div>
            </div>
        </div>
    </div>

    <h3 class="gallery-title">📸 My Favorite Moments</h3>
    <div class="photo-row">
        <img src="Image/profile1.jpg" class="gallery-img" alt="School">
        <img src="Image/profile110.jpg" class="gallery-img" alt="Learning">
        <img src="Image/profile3.jpg" class="gallery-img" alt="Friends">
        <img src="Image/profile4.jpg" class="gallery-img" alt="Travel">
    </div>
</div>

   